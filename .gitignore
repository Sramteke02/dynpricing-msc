# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Project artefacts
# NOTE: results/ and configs/calibrated.json are tracked on purpose so the
# reported experiment output is preserved alongside the code.
wandb/
*.png
!results/*.png
!results/archive/*.png
!results/figures/*.png
results/*.log

# Secrets — API keys live in the environment or in one of these files, NEVER
# in source. MISTRAL_API_KEY (and OPENAI_API_KEY) are read via os.environ only;
# see llm_agent.PROVIDERS. Keep every pattern here even if the file does not
# exist yet: the point is that creating one can never stage it by accident.
.env
.env.*
!.env.example
*.env
secrets.toml
.streamlit/secrets.toml
.streamlit/*.toml
!.streamlit/config.toml

# Data (large, downloaded separately)
data/*
!data/README.md

# Tooling
.pytest_cache/
.coverage
htmlcov/
.DS_Store
.ipynb_checkpoints/
